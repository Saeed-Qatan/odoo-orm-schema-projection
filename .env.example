APP_NAME="Odoo ORM Schema Projection"
DEBUG=false
SCHEMA_SQL_PATH=data/raw/odoo/schema.sql
ORM_SCHEMA_PATH=data/processed/odoo_orm_schema.json
GRAPH_PATH=data/processed/odoo_schema_graph.json
INDEX_DIR=data/indexes
ENABLE_DENSE_RETRIEVAL=false
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
PROJECT_SCHEMA_RATE_LIMIT_PER_MINUTE=30
READ_RATE_LIMIT_PER_MINUTE=100
REQUEST_TIMEOUT_MS=1500
